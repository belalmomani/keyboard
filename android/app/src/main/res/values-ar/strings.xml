    <!-- Why a connection failed -->
    <string name="failure_unreachable_title">تعذّر الوصول إلى %1$s</string>
    <string name="failure_unreachable_body">تأكد أن الحاسوب يعمل وأن Beckon شغّال وأن الجهازين على الشبكة نفسها. وإن كانا كذلك فقد يكون جدار حماية الحاسوب يحجب Beckon: اسمح بالمنفذ UDP 5000.</string>
    <string name="failure_unreachable_same_network">%1$s (%2$s) على هذه الشبكة، فالأرجح أن الحاسوب هو الذي يحجب Beckon. اسمح بالمنفذ UDP 5000 في جدار حمايته (قاعدة جدار حماية Linux يجب أن تشمل الاتصال الذي يستخدمه الحاسوب، Wi‑Fi أو Ethernet)، ثم حاول مرة أخرى.</string>
    <string name="failure_unreachable_other_network">هذا الهاتف على %3$s، لكن %1$s كان آخر مرة على %2$s: شبكة مختلفة. انضم إلى شبكة الحاسوب، أو امسح رمز QR الخاص به مجددًا ليجده Beckon.</string>
    <string name="failure_unreachable_no_network">هذا الهاتف ليس على شبكة Wi‑Fi. صِله بالشبكة نفسها التي عليها %1$s ثم حاول مرة أخرى.</string>
    <string name="failure_not_paired_title">%1$s لم يقبل هذا الهاتف</string>
    <string name="failure_not_paired_body">لا يقبل الحاسوب هواتف جديدة إلا أثناء فتح الإقران أو برمز QR جديد. على الحاسوب اضغط أيقونة Beckon واختر «إقران هاتف»، ثم امسح الرمز الجديد.</string>
    <string name="failure_key_changed_title">تغيّر %1$s</string>
    <string name="failure_key_changed_body">يردّ بهوية مختلفة عن الهوية التي أُقرن بها.</string>
    <string name="failure_handshake_title">تعذّر تأمين الاتصال</string>
    <string name="failure_handshake_body">ردّ %1$s لكن تعذّر إنشاء اتصال آمن. حاول مرة أخرى، وإن تكرر الأمر فانسَ الحاسوب وأقرنه من جديد.</string>
    <string name="failure_lost_title">انقطع الاتصال بـ %1$s</string>
    <string name="failure_lost_body">توقف عن الردّ. تأكد أن الحاسوب مستيقظ وعلى الشبكة نفسها.</string>
    <string name="failure_bt_unsupported_title">لوحة مفاتيح البلوتوث غير متاحة</string>
    <string name="failure_bt_unsupported_body">لا يستطيع هذا الهاتف العمل كلوحة مفاتيح وفأرة بلوتوث. استخدم Wi‑Fi بدلًا من ذلك.</string>
    <string name="failure_bt_disabled_title">البلوتوث مغلق</string>
    <string name="failure_bt_disabled_body">شغّل البلوتوث ثم حاول مرة أخرى.</string>
    <string name="failure_bt_permission_title">مطلوب إذن البلوتوث</string>
    <string name="failure_bt_permission_body">يحتاج Beckon إلى إذن للتواصل مع أجهزة البلوتوث المقترنة.</string>
    <string name="failure_bt_failed_title">تعذّر الاتصال عبر البلوتوث</string>
    <string name="failure_bt_failed_body">تأكد أن %1$s أُقرن بهذا الهاتف من إعدادات البلوتوث، وأن تطبيقًا آخر لا يستخدم دور لوحة مفاتيح البلوتوث.</string>

    <!-- Pairing -->
    <string name="pairing_contacting">جارٍ الاتصال بـ %1$s…</string>
    <string name="pairing_verify_title">تحقق من هذا الحاسوب</string>
    <string name="pairing_verify_body">تأكد أن هذا الرمز يطابق الرمز الذي يعرضه Beckon على %1$s، تحت «هذا الحاسوب» في صفحة «إقران هاتف».</string>
    <string name="pairing_verify_warning">إن لم يتطابقا فلا تتابع: قد يكون شيء آخر على الشبكة هو من يردّ.</string>
    <string name="pairing_matches">متطابقان</string>
    <string name="pairing_connecting">جارٍ الاتصال…</string>
    <string name="pairing_changed_title">%1$s له هوية جديدة</string>
    <string name="pairing_changed_body">أُقرن هذا الحاسوب من قبل، لكنه يردّ الآن بمفتاح مختلف. يحدث هذا إذا أُعيد تثبيت Beckon عليه، وقد يعني أيضًا أن شيئًا آخر على الشبكة ينتحل صفته.</string>
    <string name="pairing_changed_advice">تابع فقط إذا أعدت تثبيت Beckon على هذا الحاسوب وكان هذا الرمز يطابق ما يعرضه الآن.</string>
    <string name="pairing_changed_continue">الوثوق بالمفتاح الجديد</string>
    <string name="pairing_not_paired_title">%1$s لا يعرف هذا الهاتف بعد</string>
    <string name="pairing_not_paired_body">حرصًا على الأمان لا يقبل الحاسوب إلا الهواتف التي تمسح رمز QR الخاص به. على الحاسوب اضغط أيقونة Beckon واختر «إقران هاتف»، ثم امسح الرمز وحاول مرة أخرى.</string>
    <string name="pairing_security_note">الإقران يتم مرة واحدة. وكل ما يُرسَل بعده مشفّر.</string>

